  n<// Defines the debugger CPU_CTL.RST_BRK_EN reset value> u<315> t<LINE_COMMENT> p<5796> s<316> f<1> l<184:1> el<184:55>
  n<// (CPU break on PUC reset)> u<316> t<LINE_COMMENT> p<5796> s<317> f<1> l<185:1> el<185:28>
