  n<//`define SYNC_DBG_EN> u<295> t<LINE_COMMENT> p<3141> s<296> f<1> l<159:1> el<159:22>
  n<//-------------------------------------------------------> u<296> t<LINE_COMMENT> p<3141> s<297> f<1> l<162:1> el<162:58>
  n<// Peripheral Memory Space:> u<297> t<LINE_COMMENT> p<3141> s<298> f<1> l<163:1> el<163:28>
  n<//-------------------------------------------------------> u<298> t<LINE_COMMENT> p<3141> s<299> f<1> l<164:1> el<164:58>
  n<// The original MSP430 architecture map the peripherals> u<299> t<LINE_COMMENT> p<3141> s<300> f<1> l<165:1> el<165:56>
  n<// from 0x0000 to 0x01FF (i.e. 512B of the memory space).> u<300> t<LINE_COMMENT> p<3141> s<301> f<1> l<166:1> el<166:58>
