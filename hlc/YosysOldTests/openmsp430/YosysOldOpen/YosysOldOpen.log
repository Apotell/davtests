  n<//-------------------------------------------------------> u<352> t<LINE_COMMENT> p<3141> s<353> f<1> l<227:1> el<227:58>
  n<// Enable/Disable the hardware breakpoint RANGE mode> u<353> t<LINE_COMMENT> p<3141> s<354> f<1> l<228:1> el<228:53>
  n<//-------------------------------------------------------> u<354> t<LINE_COMMENT> p<3141> s<355> f<1> l<229:1> el<229:58>
