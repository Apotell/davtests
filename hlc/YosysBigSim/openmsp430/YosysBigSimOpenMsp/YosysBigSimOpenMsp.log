  n<// Defines the debugger CPU_CTL.RST_BRK_EN reset value> u<319> t<LINE_COMMENT> p<5045> s<320> f<1> l<184:1> el<184:55>
  n<// (CPU break on PUC reset)> u<320> t<LINE_COMMENT> p<5045> s<321> f<1> l<185:1> el<185:28>
