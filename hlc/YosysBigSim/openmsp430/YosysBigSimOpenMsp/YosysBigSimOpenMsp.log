  n<//-------------------------------------------------------> u<346> t<LINE_COMMENT> p<3472> s<347> f<1> l<217:1> el<217:58>
  n<// Enable the I2C broadcast address> u<347> t<LINE_COMMENT> p<3472> s<348> f<1> l<218:1> el<218:36>
  n<//-------------------------------------------------------> u<348> t<LINE_COMMENT> p<3472> s<349> f<1> l<219:1> el<219:58>
