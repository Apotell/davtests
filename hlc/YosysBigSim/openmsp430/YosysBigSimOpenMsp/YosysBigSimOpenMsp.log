  n<//-------------------------------------------------------> u<376> t<LINE_COMMENT> p<4123> s<377> f<1> l<252:1> el<252:58>
  n<// When enabled this feature allows the hardware breakpoint> u<377> t<LINE_COMMENT> p<4123> s<378> f<1> l<253:1> el<253:60>
