  n<// this option can stay commented-out.> u<353> t<LINE_COMMENT> p<5045> s<354> f<1> l<225:1> el<225:39>
  n<//-------------------------------------------------------> u<354> t<LINE_COMMENT> p<5045> s<355> f<1> l<226:1> el<226:58>
  n<//`define DBG_I2C_BROADCAST> u<355> t<LINE_COMMENT> p<5045> s<356> f<1> l<227:1> el<227:28>
  n<//-------------------------------------------------------> u<356> t<LINE_COMMENT> p<5045> s<357> f<1> l<230:1> el<230:58>
  n<// Number of hardware breakpoint/watchpoint units> u<357> t<LINE_COMMENT> p<5045> s<358> f<1> l<231:1> el<231:50>
  n<// (each unit contains two hardware addresses available> u<358> t<LINE_COMMENT> p<5045> s<359> f<1> l<232:1> el<232:56>
  n<// for breakpoints or watchpoints):> u<359> t<LINE_COMMENT> p<5045> s<360> f<1> l<233:1> el<233:36>
  n<//   - DBG_HWBRK_0 -> Include hardware breakpoints unit 0> u<360> t<LINE_COMMENT> p<5045> s<361> f<1> l<234:1> el<234:58>
  n<//   - DBG_HWBRK_1 -> Include hardware breakpoints unit 1> u<361> t<LINE_COMMENT> p<5045> s<362> f<1> l<235:1> el<235:58>
