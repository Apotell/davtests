  n<//-------------------------------------------------------> u<270> t<LINE_COMMENT> p<10007> s<271> f<1> l<123:1> el<123:58>
  n<// Include/Exclude Watchdog timer> u<271> t<LINE_COMMENT> p<10007> s<272> f<1> l<124:1> el<124:34>
  n<//-------------------------------------------------------> u<272> t<LINE_COMMENT> p<10007> s<273> f<1> l<125:1> el<125:58>
  n<// When excluded, the following functionality will be> u<273> t<LINE_COMMENT> p<10007> s<274> f<1> l<126:1> el<126:54>
  n<// lost:> u<274> t<LINE_COMMENT> p<10007> s<275> f<1> l<127:1> el<127:9>
