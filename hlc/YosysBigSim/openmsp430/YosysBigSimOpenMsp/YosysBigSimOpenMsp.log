  n<//`define  DBG_HWBRK_2> u<373> t<LINE_COMMENT> p<3472> s<374> f<1> l<246:1> el<246:23>
  n<//`define  DBG_HWBRK_3> u<374> t<LINE_COMMENT> p<3472> s<375> f<1> l<247:1> el<247:23>
  n<//-------------------------------------------------------> u<375> t<LINE_COMMENT> p<3472> s<376> f<1> l<250:1> el<250:58>
  n<// Enable/Disable the hardware breakpoint RANGE mode> u<376> t<LINE_COMMENT> p<3472> s<377> f<1> l<251:1> el<251:53>
  n<//-------------------------------------------------------> u<377> t<LINE_COMMENT> p<3472> s<378> f<1> l<252:1> el<252:58>
  n<// When enabled this feature allows the hardware breakpoint> u<378> t<LINE_COMMENT> p<3472> s<379> f<1> l<253:1> el<253:60>
  n<// units to stop the cpu whenever an instruction or data> u<379> t<LINE_COMMENT> p<3472> s<380> f<1> l<254:1> el<254:57>
