  n<//`define  DBG_HWBRK_2> u<372> t<LINE_COMMENT> p<4123> s<373> f<1> l<246:1> el<246:23>
  n<//`define  DBG_HWBRK_3> u<373> t<LINE_COMMENT> p<4123> s<374> f<1> l<247:1> el<247:23>
  n<//-------------------------------------------------------> u<374> t<LINE_COMMENT> p<4123> s<375> f<1> l<250:1> el<250:58>
