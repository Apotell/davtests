  n<//`define SYNC_DBG_EN> u<299> t<LINE_COMMENT> p<4413> s<300> f<1> l<159:1> el<159:22>
  n<//-------------------------------------------------------> u<300> t<LINE_COMMENT> p<4413> s<301> f<1> l<162:1> el<162:58>
  n<// Peripheral Memory Space:> u<301> t<LINE_COMMENT> p<4413> s<302> f<1> l<163:1> el<163:28>
  n<//-------------------------------------------------------> u<302> t<LINE_COMMENT> p<4413> s<303> f<1> l<164:1> el<164:58>
  n<// The original MSP430 architecture map the peripherals> u<303> t<LINE_COMMENT> p<4413> s<304> f<1> l<165:1> el<165:56>
  n<// from 0x0000 to 0x01FF (i.e. 512B of the memory space).> u<304> t<LINE_COMMENT> p<4413> s<305> f<1> l<166:1> el<166:58>
  n<// The following defines allow you to expand this space> u<305> t<LINE_COMMENT> p<4413> s<306> f<1> l<167:1> el<167:56>
  n<// up to 32 kB (i.e. from 0x0000 to 0x7fff).> u<306> t<LINE_COMMENT> p<4413> s<307> f<1> l<168:1> el<168:45>
  n<// As a consequence, the data memory mapping will be> u<307> t<LINE_COMMENT> p<4413> s<308> f<1> l<169:1> el<169:53>
  n<// shifted up and a custom linker script will therefore> u<308> t<LINE_COMMENT> p<4413> s<309> f<1> l<170:1> el<170:56>
  n<// be required by the GCC compiler.> u<309> t<LINE_COMMENT> p<4413> s<310> f<1> l<171:1> el<171:36>
