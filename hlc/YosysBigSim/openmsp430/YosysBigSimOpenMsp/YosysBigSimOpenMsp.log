  n<//-------------------------------------------------------> u<345> t<LINE_COMMENT> p<5045> s<346> f<1> l<217:1> el<217:58>
  n<// Enable the I2C broadcast address> u<346> t<LINE_COMMENT> p<5045> s<347> f<1> l<218:1> el<218:36>
  n<//-------------------------------------------------------> u<347> t<LINE_COMMENT> p<5045> s<348> f<1> l<219:1> el<219:58>
