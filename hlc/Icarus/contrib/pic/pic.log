    n<// This is the PIC Instruction Decoder.> u<8003> t<LINE_COMMENT> p<20732> s<8004> l<1049:1> el<1049:40>
    n<//> u<8004> t<LINE_COMMENT> p<20732> s<8005> l<1050:1> el<1050:3>
    n<// The 12-bit PIC instruction must result in a set of control> u<8005> t<LINE_COMMENT> p<20732> s<8006> l<1051:1> el<1051:62>
    n<// signals to the ALU, register write enables and other wires.> u<8006> t<LINE_COMMENT> p<20732> s<8007> l<1052:1> el<1052:63>
