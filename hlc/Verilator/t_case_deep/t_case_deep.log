        n</*\n#!/usr/bin/perl -w\nsrand(5);\nmy @used;\npat:\n  for (my $pat=0; 1; ) {\n    last if $pat > 196;\n    my $len = int($pat / (6 + $pat/50)) + 4;  $len=20 if $len>20;\n    my ($try, $val, $mask);\n  try:\n    for ($try=0; ; $try++) {\n	next pat if $try>50;\n	$val = 0;\n	for (my $bit=23; $bit>(23-$len); $bit--) {\n	    my $b = int(rand()*2);\n	    $val |= (1<<$bit) if $b;\n	}\n	$mask = (1<<(23-$len+1))-1;\n	for (my $testval = $val; $testval <= ($val + $mask); $testval ++) {\n	    next try if $used[$testval];\n	}\n	last;\n    }\n    my $bits = "";\n    my $val2 = 0;\n    for (my $bit=23; $bit>(23-$len); $bit--) {\n	my $b = ($val & (1<<$bit));\n	$bits .= $b?'1':'0';\n    }\n    for (my $testval = $val; $testval <= ($val + $mask); $testval++) {\n	$used[$testval]= 1; #printf "U%08x\n", $testval;\n    }\n    if ($try<90) {\n	printf +("     24'b%s: {next, len, code} = {in[%02d], 5'd%02d, 32'd%03d};\n"\n		 ,$bits.("?"x(24-$len)), 31-$len, $len, $pat);\n	$pat++;\n    }\n}\n*/> u<876> t<BLOCK_COMMENT> p<10331> s<10329> l<129:4> el<340:7>
