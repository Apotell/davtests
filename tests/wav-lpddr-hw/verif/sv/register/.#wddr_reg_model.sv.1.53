  //Map         : MAP_APB     0x0
  //Reset       : 0x400d008 
  //Description : 
  function void build;
    //Description: +/- range to be considered in target. Outside range will increment/decrement band setting
    VCO1_FLL_RANGE = uvm_reg_field::type_id::create("VCO1_FLL_RANGE");  //CMN_PLL_MVP_PLL_VCO1_FLL_CONTROL2__VCO1_FLL_RANGE
    VCO1_FLL_RANGE.configure(this, 5, 24, "RW", 0, 'h4, 1, 1, 0);
