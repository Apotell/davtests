class WDDR_CMN_PLL_CMN_PLL_MVP_PLL_STATE_MACHINE_CONTROLS_ extends uvm_reg;
  `uvm_object_utils(WDDR_CMN_PLL_CMN_PLL_MVP_PLL_STATE_MACHINE_CONTROLS_)

  rand uvm_reg_field FLL_INITIAL_SETTLE;
  rand uvm_reg_field DISABLE_LOCK_DET_AFTER_LOCK;
  rand uvm_reg_field SWITCH_COUNT;
  rand uvm_reg_field PRE_LOCKING_COUNT;
  rand uvm_reg_field BIAS_SETTLE_COUNT;

  function new (string name = "WDDR_CMN_PLL_CMN_PLL_MVP_PLL_STATE_MACHINE_CONTROLS_");
    super.new(name, 32, UVM_NO_COVERAGE);
  endfunction

  //Addr        : 0x9808c    (Includes Map Offset)
  //Map         : MAP_APB     0x0
  //Reset       : 0x810408  
  //Description : 
  function void build;
    //Description: Initial settle time for FLLs when enabling. Provides some time for the VCO to ramp up.
    FLL_INITIAL_SETTLE = uvm_reg_field::type_id::create("FLL_INITIAL_SETTLE");  //CMN_PLL_MVP_PLL_STATE_MACHINE_CONTROLS__FLL_INITIAL_SETTLE
    FLL_INITIAL_SETTLE.configure(this, 4, 21, "RW", 0, 'h4, 1, 1, 0);
    //Description: 1 - Lock Detection circuit is disabled after lock is seen. 0 - Lock detection always enabled. Disabling lock detect would mean loss of lock is not possible to detect.
    DISABLE_LOCK_DET_AFTER_LOCK = uvm_reg_field::type_id::create("DISABLE_LOCK_DET_AFTER_LOCK");  //CMN_PLL_MVP_PLL_STATE_MACHINE_CONTROLS__DISABLE_LOCK_DET_AFTER_LOCK
    DISABLE_LOCK_DET_AFTER_LOCK.configure(this, 1, 20, "RW", 0, 'h0, 1, 1, 0);
    //Description: Number of refclk cycles to wait with FBCLK disabled when performing a VCO switch
    SWITCH_COUNT = uvm_reg_field::type_id::create("SWITCH_COUNT");  //CMN_PLL_MVP_PLL_STATE_MACHINE_CONTROLS__SWITCH_COUNT
    SWITCH_COUNT.configure(this, 4, 16, "RW", 0, 'h1, 1, 1, 0);
    //Description: Number of refclk cycles to wait until entering normal lock after fast lock
    PRE_LOCKING_COUNT = uvm_reg_field::type_id::create("PRE_LOCKING_COUNT");  //CMN_PLL_MVP_PLL_STATE_MACHINE_CONTROLS__PRE_LOCKING_COUNT
    PRE_LOCKING_COUNT.configure(this, 8, 8, "RW", 0, 'h4, 1, 1, 0);
    //Description: Number of refclk cycles to wait until entering the fastlock routine
    BIAS_SETTLE_COUNT = uvm_reg_field::type_id::create("BIAS_SETTLE_COUNT");  //CMN_PLL_MVP_PLL_STATE_MACHINE_CONTROLS__BIAS_SETTLE_COUNT
    BIAS_SETTLE_COUNT.configure(this, 8, 0, "RW", 0, 'h8, 1, 1, 0);
  endfunction
endclass

class WDDR_CMN_PLL_CMN_PLL_MVP_PLL_STATE_MACHINE_CONTROLS2_ extends uvm_reg;
  `uvm_object_utils(WDDR_CMN_PLL_CMN_PLL_MVP_PLL_STATE_MACHINE_CONTROLS2_)

  rand uvm_reg_field SWITCH_2_TIME;
  rand uvm_reg_field SWITCH_1_TIME;
  rand uvm_reg_field SWITCH_RESET_TIME;
  rand uvm_reg_field PRE_SWITCH_TIME;

  function new (string name = "WDDR_CMN_PLL_CMN_PLL_MVP_PLL_STATE_MACHINE_CONTROLS2_");
    super.new(name, 32, UVM_NO_COVERAGE);
  endfunction

  //Addr        : 0x98090    (Includes Map Offset)
  //Map         : MAP_APB     0x0
  //Reset       : 0x10311   
  //Description : 
  function void build;
    //Description: Number of cycles to hold both VCOs enabled after the clock mux switch.
    SWITCH_2_TIME = uvm_reg_field::type_id::create("SWITCH_2_TIME");  //CMN_PLL_MVP_PLL_STATE_MACHINE_CONTROLS2__SWITCH_2_TIME
    SWITCH_2_TIME.configure(this, 8, 16, "RW", 0, 'h1, 1, 1, 0);
    //Description: Number of cycles to the next VCO is allowed to be in PLL mode before switching the clock mux. Increasing this can allow the VCO more time to phase lock before swtiching the clock mux.
    SWITCH_1_TIME = uvm_reg_field::type_id::create("SWITCH_1_TIME");  //CMN_PLL_MVP_PLL_STATE_MACHINE_CONTROLS2__SWITCH_1_TIME
    SWITCH_1_TIME.configure(this, 8, 8, "RW", 0, 'h3, 1, 1, 0);
    //Description: Number of cycles to hold the PLL PFD in reset to allow VCO swtich
    SWITCH_RESET_TIME = uvm_reg_field::type_id::create("SWITCH_RESET_TIME");  //CMN_PLL_MVP_PLL_STATE_MACHINE_CONTROLS2__SWITCH_RESET_TIME
    SWITCH_RESET_TIME.configure(this, 4, 4, "RW", 0, 'h1, 1, 1, 0);
    //Description: Number of cycles prior to enabling the next VCO to disable the FBCLK
    PRE_SWITCH_TIME = uvm_reg_field::type_id::create("PRE_SWITCH_TIME");  //CMN_PLL_MVP_PLL_STATE_MACHINE_CONTROLS2__PRE_SWITCH_TIME
    PRE_SWITCH_TIME.configure(this, 4, 0, "RW", 0, 'h1, 1, 1, 0);
  endfunction
endclass

