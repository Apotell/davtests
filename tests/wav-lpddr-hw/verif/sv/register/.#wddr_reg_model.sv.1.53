    //Description: +/- range to be considered in target. Outside range will increment/decrement band setting
    VCO2_FLL_RANGE = uvm_reg_field::type_id::create("VCO2_FLL_RANGE");  //CMN_PLL_MVP_PLL_VCO2_FLL_CONTROL2__VCO2_FLL_RANGE
    VCO2_FLL_RANGE.configure(this, 5, 24, "RW", 0, 'h4, 1, 1, 0);
    //Description: Number of expected VCO cycles. Target = (refclk_count * refclk period) / vcoclk period
    VCO2_FLL_VCO_COUNT_TARGET = uvm_reg_field::type_id::create("VCO2_FLL_VCO_COUNT_TARGET");  //CMN_PLL_MVP_PLL_VCO2_FLL_CONTROL2__VCO2_FLL_VCO_COUNT_TARGET
    VCO2_FLL_VCO_COUNT_TARGET.configure(this, 16, 8, "RW", 0, 'hd0, 1, 1, 0);
    //Description: Number of Refclk Cycles to Enable VCO Counter
    VCO2_FLL_REFCLK_COUNT = uvm_reg_field::type_id::create("VCO2_FLL_REFCLK_COUNT");  //CMN_PLL_MVP_PLL_VCO2_FLL_CONTROL2__VCO2_FLL_REFCLK_COUNT
    VCO2_FLL_REFCLK_COUNT.configure(this, 8, 0, "RW", 0, 'h8, 1, 1, 0);
