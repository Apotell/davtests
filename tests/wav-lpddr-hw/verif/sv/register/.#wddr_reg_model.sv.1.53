class WDDR_CMN_PLL_CMN_PLL_MVP_PLL_CORE_STATUS_ extends uvm_reg;
  `uvm_object_utils(WDDR_CMN_PLL_CMN_PLL_MVP_PLL_CORE_STATUS_)

  rand uvm_reg_field FSM_STATE;
  rand uvm_reg_field FREQ_DETECT_CYCLES;
  rand uvm_reg_field FREQ_DETECT_LOCK;
  rand uvm_reg_field CORE_INITIAL_SWITCH_DONE;
  rand uvm_reg_field CORE_FASTLOCK_READY;
  rand uvm_reg_field CORE_READY;

  function new (string name = "WDDR_CMN_PLL_CMN_PLL_MVP_PLL_CORE_STATUS_");
    super.new(name, 32, UVM_NO_COVERAGE);
  endfunction

  //Addr        : 0x9800c    (Includes Map Offset)
  //Map         : MAP_APB     0x0
  //Reset       : 0x0       
  //Description : Status fields for debug
  function void build;
    //Description: FSM State
    FSM_STATE = uvm_reg_field::type_id::create("FSM_STATE");  //CMN_PLL_MVP_PLL_CORE_STATUS__FSM_STATE
    FSM_STATE.configure(this, 4, 21, "RO", 0, 'h0, 1, 1, 0);
    //Description: Current FB cycles from freq detection circuit
    FREQ_DETECT_CYCLES = uvm_reg_field::type_id::create("FREQ_DETECT_CYCLES");  //CMN_PLL_MVP_PLL_CORE_STATUS__FREQ_DETECT_CYCLES
    FREQ_DETECT_CYCLES.configure(this, 17, 4, "RO", 0, 'h0, 1, 1, 0);
    //Description: Status of the freq detection circuit
    FREQ_DETECT_LOCK = uvm_reg_field::type_id::create("FREQ_DETECT_LOCK");  //CMN_PLL_MVP_PLL_CORE_STATUS__FREQ_DETECT_LOCK
    FREQ_DETECT_LOCK.configure(this, 1, 3, "RO", 0, 'h0, 1, 1, 0);
    //Description: Asserts when the state machine has gone through the VCO swtich and is on the next VCO.
    CORE_INITIAL_SWITCH_DONE = uvm_reg_field::type_id::create("CORE_INITIAL_SWITCH_DONE");  //CMN_PLL_MVP_PLL_CORE_STATUS__CORE_INITIAL_SWITCH_DONE
    CORE_INITIAL_SWITCH_DONE.configure(this, 1, 2, "RO", 0, 'h0, 1, 1, 0);
    //Description: Asserts when the state machine has gone through the fast lock process (but not entire lock)
    CORE_FASTLOCK_READY = uvm_reg_field::type_id::create("CORE_FASTLOCK_READY");  //CMN_PLL_MVP_PLL_CORE_STATUS__CORE_FASTLOCK_READY
    CORE_FASTLOCK_READY.configure(this, 1, 1, "RO", 0, 'h0, 1, 1, 0);
    //Description: Asserts when the state machine has gone through the entire lock process
    CORE_READY = uvm_reg_field::type_id::create("CORE_READY");  //CMN_PLL_MVP_PLL_CORE_STATUS__CORE_READY
    CORE_READY.configure(this, 1, 0, "RO", 0, 'h0, 1, 1, 0);
  endfunction
endclass

class WDDR_CMN_PLL_CMN_PLL_MVP_PLL_CORE_STATUS_INT_ extends uvm_reg;
  `uvm_object_utils(WDDR_CMN_PLL_CMN_PLL_MVP_PLL_CORE_STATUS_INT_)

  rand uvm_reg_field VCO2_FLL_THRESHOLD;
  rand uvm_reg_field VCO2_FLL_LOCKED;
  rand uvm_reg_field VCO1_FLL_THRESHOLD;
  rand uvm_reg_field VCO1_FLL_LOCKED;
  rand uvm_reg_field VCO0_FLL_THRESHOLD;
  rand uvm_reg_field VCO0_FLL_LOCKED;
  rand uvm_reg_field INITIAL_SWITCH_DONE;
  rand uvm_reg_field CORE_LOCKED;
  rand uvm_reg_field LOSS_OF_LOCK;

  function new (string name = "WDDR_CMN_PLL_CMN_PLL_MVP_PLL_CORE_STATUS_INT_");
    super.new(name, 32, UVM_NO_COVERAGE);
  endfunction

  //Addr        : 0x98010    (Includes Map Offset)
  //Map         : MAP_APB     0x0
  //Reset       : 0x0       
  //Description : Interrupt status register
  function void build;
    //Description: Asserts when the FLL hits the threshold value or higher during freq lock.
    VCO2_FLL_THRESHOLD = uvm_reg_field::type_id::create("VCO2_FLL_THRESHOLD");  //CMN_PLL_MVP_PLL_CORE_STATUS_INT__VCO2_FLL_THRESHOLD
    VCO2_FLL_THRESHOLD.configure(this, 1, 8, "W1C", 0, 'h0, 1, 1, 0);
    //Description: Asserts when the FLL has completed calibrations and is conceptually locked. (Informative)
    VCO2_FLL_LOCKED = uvm_reg_field::type_id::create("VCO2_FLL_LOCKED");  //CMN_PLL_MVP_PLL_CORE_STATUS_INT__VCO2_FLL_LOCKED
    VCO2_FLL_LOCKED.configure(this, 1, 7, "W1C", 0, 'h0, 1, 1, 0);
    //Description: Asserts when the FLL hits the threshold value or higher during freq lock.
    VCO1_FLL_THRESHOLD = uvm_reg_field::type_id::create("VCO1_FLL_THRESHOLD");  //CMN_PLL_MVP_PLL_CORE_STATUS_INT__VCO1_FLL_THRESHOLD
    VCO1_FLL_THRESHOLD.configure(this, 1, 6, "W1C", 0, 'h0, 1, 1, 0);
    //Description: Asserts when the FLL has completed calibrations and is conceptually locked. (Informative)
    VCO1_FLL_LOCKED = uvm_reg_field::type_id::create("VCO1_FLL_LOCKED");  //CMN_PLL_MVP_PLL_CORE_STATUS_INT__VCO1_FLL_LOCKED
    VCO1_FLL_LOCKED.configure(this, 1, 5, "W1C", 0, 'h0, 1, 1, 0);
    //Description: Asserts when the FLL hits the threshold value or higher during freq lock.
    VCO0_FLL_THRESHOLD = uvm_reg_field::type_id::create("VCO0_FLL_THRESHOLD");  //CMN_PLL_MVP_PLL_CORE_STATUS_INT__VCO0_FLL_THRESHOLD
    VCO0_FLL_THRESHOLD.configure(this, 1, 4, "W1C", 0, 'h0, 1, 1, 0);
    //Description: Asserts when the FLL has completed calibrations and is conceptually locked. (Informative)
    VCO0_FLL_LOCKED = uvm_reg_field::type_id::create("VCO0_FLL_LOCKED");  //CMN_PLL_MVP_PLL_CORE_STATUS_INT__VCO0_FLL_LOCKED
    VCO0_FLL_LOCKED.configure(this, 1, 3, "W1C", 0, 'h0, 1, 1, 0);
    //Description: Asserts when the main state machine has gone through the initial switch transition.
    INITIAL_SWITCH_DONE = uvm_reg_field::type_id::create("INITIAL_SWITCH_DONE");  //CMN_PLL_MVP_PLL_CORE_STATUS_INT__INITIAL_SWITCH_DONE
    INITIAL_SWITCH_DONE.configure(this, 1, 2, "W1C", 0, 'h0, 1, 1, 0);
    //Description: Asserts when the main state machine has gone through the PLL enabling routine and lock has been detected. (Informative)
    CORE_LOCKED = uvm_reg_field::type_id::create("CORE_LOCKED");  //CMN_PLL_MVP_PLL_CORE_STATUS_INT__CORE_LOCKED
    CORE_LOCKED.configure(this, 1, 1, "W1C", 0, 'h0, 1, 1, 0);
    //Description: Asserts when the lock detection circuit loses lock after initially seeing lock. 
    LOSS_OF_LOCK = uvm_reg_field::type_id::create("LOSS_OF_LOCK");  //CMN_PLL_MVP_PLL_CORE_STATUS_INT__LOSS_OF_LOCK
    LOSS_OF_LOCK.configure(this, 1, 0, "W1C", 0, 'h0, 1, 1, 0);
  endfunction
endclass

class WDDR_CMN_PLL_CMN_PLL_MVP_PLL_CORE_STATUS_INT_EN_ extends uvm_reg;
  `uvm_object_utils(WDDR_CMN_PLL_CMN_PLL_MVP_PLL_CORE_STATUS_INT_EN_)

