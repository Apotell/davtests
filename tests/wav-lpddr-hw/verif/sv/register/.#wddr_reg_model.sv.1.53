  endfunction

  //Addr        : 0x4        (Includes Map Offset)
  //Map         : MAP_APB     0x0
  //Reset       : 0x0       
  //Description : Top level configuration register.
  function void build;
    //Description: 
    FETCH_EN = uvm_reg_field::type_id::create("FETCH_EN");  //       CFG__FETCH_EN
    FETCH_EN.configure(this, 1, 0, "RW", 0, 'h0, 1, 1, 0);
    //Description: 
    DEBUG_EN = uvm_reg_field::type_id::create("DEBUG_EN");  //       CFG__DEBUG_EN
    DEBUG_EN.configure(this, 1, 1, "RW", 0, 'h0, 1, 1, 0);
  endfunction
endclass

