  rand uvm_reg_field VCO1_FLL_THRESHOLD_INT_EN;
  rand uvm_reg_field VCO1_FLL_LOCKED_INT_EN;
  rand uvm_reg_field VCO0_FLL_THRESHOLD_INT_EN;
  rand uvm_reg_field VCO0_FLL_LOCKED_INT_EN;
  rand uvm_reg_field INITIAL_SWITCH_DONE_INT_EN;
  rand uvm_reg_field CORE_LOCKED_INT_EN;
  rand uvm_reg_field LOSS_OF_LOCK_INT_EN;

  function new (string name = "WDDR_CMN_PLL_CMN_PLL_MVP_PLL_CORE_STATUS_INT_EN_");
