// RegBlock WDDR_CMN_PLL_
class WDDR_CMN_PLL_CMN_PLL_MVP_PLL_CORE_OVERRIDES_ extends uvm_reg;
  `uvm_object_utils(WDDR_CMN_PLL_CMN_PLL_MVP_PLL_CORE_OVERRIDES_)

  rand uvm_reg_field CORE_GFCM_SEL_MUX;
  rand uvm_reg_field CORE_GFCM_SEL;
  rand uvm_reg_field CORE_VCO_SEL_MUX;
  rand uvm_reg_field CORE_VCO_SEL;
  rand uvm_reg_field CORE_RESET_MUX;
  rand uvm_reg_field CORE_RESET;

  function new (string name = "WDDR_CMN_PLL_CMN_PLL_MVP_PLL_CORE_OVERRIDES_");
    super.new(name, 32, UVM_NO_COVERAGE);
  endfunction

  //Addr        : 0x98000    (Includes Map Offset)
  //Map         : MAP_APB     0x0
  //Reset       : 0x0       
  //Description : 
  function void build;
    //Description: 
    CORE_GFCM_SEL_MUX = uvm_reg_field::type_id::create("CORE_GFCM_SEL_MUX");  //CMN_PLL_MVP_PLL_CORE_OVERRIDES__CORE_GFCM_SEL_MUX
    CORE_GFCM_SEL_MUX.configure(this, 1, 6, "RW", 0, 'h0, 1, 1, 0);
    //Description: Overrides the GFCM that is external. If you aren't sure what that means, don't play with this.
    CORE_GFCM_SEL = uvm_reg_field::type_id::create("CORE_GFCM_SEL");  //CMN_PLL_MVP_PLL_CORE_OVERRIDES__CORE_GFCM_SEL
    CORE_GFCM_SEL.configure(this, 1, 5, "RW", 0, 'h0, 1, 1, 0);
    //Description: 1 - Use value from register. 0 - Use value from hardware
    CORE_VCO_SEL_MUX = uvm_reg_field::type_id::create("CORE_VCO_SEL_MUX");  //CMN_PLL_MVP_PLL_CORE_OVERRIDES__CORE_VCO_SEL_MUX
    CORE_VCO_SEL_MUX.configure(this, 1, 4, "RW", 0, 'h0, 1, 1, 0);
    //Description: Selects which VCO is in PLL mode. Requires core_switch_vco to be written to take new value.
    CORE_VCO_SEL = uvm_reg_field::type_id::create("CORE_VCO_SEL");  //CMN_PLL_MVP_PLL_CORE_OVERRIDES__CORE_VCO_SEL
    CORE_VCO_SEL.configure(this, 2, 2, "RW", 0, 'h0, 1, 1, 0);
    //Description: 1 - Use value from register. 0 - Use value from hardware
    CORE_RESET_MUX = uvm_reg_field::type_id::create("CORE_RESET_MUX");  //CMN_PLL_MVP_PLL_CORE_OVERRIDES__CORE_RESET_MUX
    CORE_RESET_MUX.configure(this, 1, 1, "RW", 0, 'h0, 1, 1, 0);
    //Description: Main logic reset
    CORE_RESET = uvm_reg_field::type_id::create("CORE_RESET");  //CMN_PLL_MVP_PLL_CORE_OVERRIDES__CORE_RESET
    CORE_RESET.configure(this, 1, 0, "RW", 0, 'h0, 1, 1, 0);
  endfunction
endclass

