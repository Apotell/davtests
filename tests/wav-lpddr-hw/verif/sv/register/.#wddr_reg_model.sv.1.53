class WDDR_CMN_PLL_CMN_PLL_MVP_PLL_VCO2_FLL_CONTROL1_ extends uvm_reg;
  `uvm_object_utils(WDDR_CMN_PLL_CMN_PLL_MVP_PLL_VCO2_FLL_CONTROL1_)

  rand uvm_reg_field VCO2_LOCKED;
  rand uvm_reg_field VCO2_TOO_SLOW_STATUS;
  rand uvm_reg_field VCO2_TOO_FAST_STATUS;
  rand uvm_reg_field VCO2_FLL_PERSISTENT_MODE;
  rand uvm_reg_field VCO2_FLL_BYPASS_FINE;
  rand uvm_reg_field VCO2_FLL_BYPASS_BAND;
  rand uvm_reg_field VCO2_LOCKED_COUNT_THRESHOLD;
  rand uvm_reg_field VCO2_USE_DEMETED_CHECK;
  rand uvm_reg_field VCO2_DELAY_COUNT;
  rand uvm_reg_field VCO2_FINE_START;
  rand uvm_reg_field VCO2_BAND_START;
  rand uvm_reg_field VCO2_FLL_MANUAL_MODE;
  rand uvm_reg_field VCO2_FLL_ENABLE;

  function new (string name = "WDDR_CMN_PLL_CMN_PLL_MVP_PLL_VCO2_FLL_CONTROL1_");
    super.new(name, 32, UVM_NO_COVERAGE);
  endfunction

  //Addr        : 0x9806c    (Includes Map Offset)
  //Map         : MAP_APB     0x0
  //Reset       : 0x249f00  
  //Description : 
  function void build;
    //Description: FLL lock indication 
    VCO2_LOCKED = uvm_reg_field::type_id::create("VCO2_LOCKED");  //CMN_PLL_MVP_PLL_VCO2_FLL_CONTROL1__VCO2_LOCKED
    VCO2_LOCKED.configure(this, 1, 28, "RO", 0, 'h0, 1, 1, 0);
    //Description: Asserted if VCO count is lower than target + range (use during manual SW calibration)
    VCO2_TOO_SLOW_STATUS = uvm_reg_field::type_id::create("VCO2_TOO_SLOW_STATUS");  //CMN_PLL_MVP_PLL_VCO2_FLL_CONTROL1__VCO2_TOO_SLOW_STATUS
    VCO2_TOO_SLOW_STATUS.configure(this, 1, 27, "RO", 0, 'h0, 1, 1, 0);
    //Description: Asserted if VCO count is higher than target + range (use during manual SW calibration)
    VCO2_TOO_FAST_STATUS = uvm_reg_field::type_id::create("VCO2_TOO_FAST_STATUS");  //CMN_PLL_MVP_PLL_VCO2_FLL_CONTROL1__VCO2_TOO_FAST_STATUS
    VCO2_TOO_FAST_STATUS.configure(this, 1, 26, "RO", 0, 'h0, 1, 1, 0);
    //Description: 0 - FLL will run until lock is detected and will hold code. 1 - FLL will continue to run, adapting to frequency changes. 
    VCO2_FLL_PERSISTENT_MODE = uvm_reg_field::type_id::create("VCO2_FLL_PERSISTENT_MODE");  //CMN_PLL_MVP_PLL_VCO2_FLL_CONTROL1__VCO2_FLL_PERSISTENT_MODE
    VCO2_FLL_PERSISTENT_MODE.configure(this, 1, 25, "RW", 0, 'h0, 1, 1, 0);
    //Description: 1 - Fine code is not calibrated during FLL enable. User would want to set the vco_fine_start to the desired band setting
    VCO2_FLL_BYPASS_FINE = uvm_reg_field::type_id::create("VCO2_FLL_BYPASS_FINE");  //CMN_PLL_MVP_PLL_VCO2_FLL_CONTROL1__VCO2_FLL_BYPASS_FINE
    VCO2_FLL_BYPASS_FINE.configure(this, 1, 24, "RW", 0, 'h0, 1, 1, 0);
    //Description: 1 - Band code is not calibrated during FLL enable. User would want to set the vco_band_start to the desired band setting
    VCO2_FLL_BYPASS_BAND = uvm_reg_field::type_id::create("VCO2_FLL_BYPASS_BAND");  //CMN_PLL_MVP_PLL_VCO2_FLL_CONTROL1__VCO2_FLL_BYPASS_BAND
    VCO2_FLL_BYPASS_BAND.configure(this, 1, 23, "RW", 0, 'h0, 1, 1, 0);
    //Description: Number of consecutive cycles where band toggles +/-1 before indicating locked
    VCO2_LOCKED_COUNT_THRESHOLD = uvm_reg_field::type_id::create("VCO2_LOCKED_COUNT_THRESHOLD");  //CMN_PLL_MVP_PLL_VCO2_FLL_CONTROL1__VCO2_LOCKED_COUNT_THRESHOLD
    VCO2_LOCKED_COUNT_THRESHOLD.configure(this, 4, 19, "RW", 0, 'h4, 1, 1, 0);
    //Description: 1 - up/dn check is based on demeted signals, 0 - up/dn is coming from VCO clock domain (ensure enough delay thorugh delay count)
    VCO2_USE_DEMETED_CHECK = uvm_reg_field::type_id::create("VCO2_USE_DEMETED_CHECK");  //CMN_PLL_MVP_PLL_VCO2_FLL_CONTROL1__VCO2_USE_DEMETED_CHECK
    VCO2_USE_DEMETED_CHECK.configure(this, 1, 18, "RW", 0, 'h1, 1, 1, 0);
    //Description: Number of Refclk Cycles to wait after deactivation of counters before checking up/dn
    VCO2_DELAY_COUNT = uvm_reg_field::type_id::create("VCO2_DELAY_COUNT");  //CMN_PLL_MVP_PLL_VCO2_FLL_CONTROL1__VCO2_DELAY_COUNT
    VCO2_DELAY_COUNT.configure(this, 4, 14, "RW", 0, 'h2, 1, 1, 0);
    //Description: Starting fine code upon enabling FLL. A mid code is **generally** the expected starting value.
    VCO2_FINE_START = uvm_reg_field::type_id::create("VCO2_FINE_START");  //CMN_PLL_MVP_PLL_VCO2_FLL_CONTROL1__VCO2_FINE_START
    VCO2_FINE_START.configure(this, 6, 8, "RW", 0, 'h1f, 1, 1, 0);
    //Description: Starting band upon enabling FLL.
    VCO2_BAND_START = uvm_reg_field::type_id::create("VCO2_BAND_START");  //CMN_PLL_MVP_PLL_VCO2_FLL_CONTROL1__VCO2_BAND_START
    VCO2_BAND_START.configure(this, 6, 2, "RW", 0, 'h0, 1, 1, 0);
    //Description: 0 - FLL will continually change band, 1 - FLL will run once (used for manual SW calibration of band)
    VCO2_FLL_MANUAL_MODE = uvm_reg_field::type_id::create("VCO2_FLL_MANUAL_MODE");  //CMN_PLL_MVP_PLL_VCO2_FLL_CONTROL1__VCO2_FLL_MANUAL_MODE
    VCO2_FLL_MANUAL_MODE.configure(this, 1, 1, "RW", 0, 'h0, 1, 1, 0);
    //Description: Enables FLL
    VCO2_FLL_ENABLE = uvm_reg_field::type_id::create("VCO2_FLL_ENABLE");  //CMN_PLL_MVP_PLL_VCO2_FLL_CONTROL1__VCO2_FLL_ENABLE
    VCO2_FLL_ENABLE.configure(this, 1, 0, "RW", 0, 'h0, 1, 1, 0);
  endfunction
endclass

class WDDR_CMN_PLL_CMN_PLL_MVP_PLL_VCO2_FLL_CONTROL2_ extends uvm_reg;
  `uvm_object_utils(WDDR_CMN_PLL_CMN_PLL_MVP_PLL_VCO2_FLL_CONTROL2_)

  rand uvm_reg_field VCO2_FLL_RANGE;
