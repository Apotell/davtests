  endfunction

  //Addr        : 0x9801c    (Includes Map Offset)
  //Map         : MAP_APB     0x0
  //Reset       : 0x0       
  //Description : 
  function void build;
    //Description: Uses refclk for VCO output clock
    VCO0_BYP_CLK_SEL = uvm_reg_field::type_id::create("VCO0_BYP_CLK_SEL");  //CMN_PLL_MVP_PLL_VCO0_CONTROL__VCO0_BYP_CLK_SEL
    VCO0_BYP_CLK_SEL.configure(this, 1, 2, "RW", 0, 'h0, 1, 1, 0);
