  endfunction

  //Addr        : 0x98014    (Includes Map Offset)
  //Map         : MAP_APB     0x0
  //Reset       : 0x0       
  //Description : Interrupt enable register
  function void build;
    //Description: 1 - Enables fll_threshold interrupt
    VCO2_FLL_THRESHOLD_INT_EN = uvm_reg_field::type_id::create("VCO2_FLL_THRESHOLD_INT_EN");  //CMN_PLL_MVP_PLL_CORE_STATUS_INT_EN__VCO2_FLL_THRESHOLD_INT_EN
    VCO2_FLL_THRESHOLD_INT_EN.configure(this, 1, 8, "RW", 0, 'h0, 1, 1, 0);
    //Description: 1 - Enables the fll_locked interrupt
    VCO2_FLL_LOCKED_INT_EN = uvm_reg_field::type_id::create("VCO2_FLL_LOCKED_INT_EN");  //CMN_PLL_MVP_PLL_CORE_STATUS_INT_EN__VCO2_FLL_LOCKED_INT_EN
    VCO2_FLL_LOCKED_INT_EN.configure(this, 1, 7, "RW", 0, 'h0, 1, 1, 0);
    //Description: 1 - Enables fll_threshold interrupt
    VCO1_FLL_THRESHOLD_INT_EN = uvm_reg_field::type_id::create("VCO1_FLL_THRESHOLD_INT_EN");  //CMN_PLL_MVP_PLL_CORE_STATUS_INT_EN__VCO1_FLL_THRESHOLD_INT_EN
    VCO1_FLL_THRESHOLD_INT_EN.configure(this, 1, 6, "RW", 0, 'h0, 1, 1, 0);
    //Description: 1 - Enables the fll_locked interrupt
    VCO1_FLL_LOCKED_INT_EN = uvm_reg_field::type_id::create("VCO1_FLL_LOCKED_INT_EN");  //CMN_PLL_MVP_PLL_CORE_STATUS_INT_EN__VCO1_FLL_LOCKED_INT_EN
    VCO1_FLL_LOCKED_INT_EN.configure(this, 1, 5, "RW", 0, 'h0, 1, 1, 0);
    //Description: 1 - Enables fll_threshold interrupt
    VCO0_FLL_THRESHOLD_INT_EN = uvm_reg_field::type_id::create("VCO0_FLL_THRESHOLD_INT_EN");  //CMN_PLL_MVP_PLL_CORE_STATUS_INT_EN__VCO0_FLL_THRESHOLD_INT_EN
    VCO0_FLL_THRESHOLD_INT_EN.configure(this, 1, 4, "RW", 0, 'h0, 1, 1, 0);
    //Description: 1 - Enables the fll_locked interrupt
    VCO0_FLL_LOCKED_INT_EN = uvm_reg_field::type_id::create("VCO0_FLL_LOCKED_INT_EN");  //CMN_PLL_MVP_PLL_CORE_STATUS_INT_EN__VCO0_FLL_LOCKED_INT_EN
    VCO0_FLL_LOCKED_INT_EN.configure(this, 1, 3, "RW", 0, 'h0, 1, 1, 0);
    //Description: 1 - Enables the initial_switch_done interrupt
    INITIAL_SWITCH_DONE_INT_EN = uvm_reg_field::type_id::create("INITIAL_SWITCH_DONE_INT_EN");  //CMN_PLL_MVP_PLL_CORE_STATUS_INT_EN__INITIAL_SWITCH_DONE_INT_EN
    INITIAL_SWITCH_DONE_INT_EN.configure(this, 1, 2, "RW", 0, 'h0, 1, 1, 0);
    //Description: 1 - Enables the core_locked interrupt
    CORE_LOCKED_INT_EN = uvm_reg_field::type_id::create("CORE_LOCKED_INT_EN");  //CMN_PLL_MVP_PLL_CORE_STATUS_INT_EN__CORE_LOCKED_INT_EN
    CORE_LOCKED_INT_EN.configure(this, 1, 1, "RW", 0, 'h0, 1, 1, 0);
    //Description: 1 - Enables loss_of_lock interrupt
    LOSS_OF_LOCK_INT_EN = uvm_reg_field::type_id::create("LOSS_OF_LOCK_INT_EN");  //CMN_PLL_MVP_PLL_CORE_STATUS_INT_EN__LOSS_OF_LOCK_INT_EN
    LOSS_OF_LOCK_INT_EN.configure(this, 1, 0, "RW", 0, 'h0, 1, 1, 0);
  endfunction
endclass

