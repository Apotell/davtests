class WDDR_MCU_MCU_MCU_DEBUG_CFG_ extends uvm_reg;
  `uvm_object_utils(WDDR_MCU_MCU_MCU_DEBUG_CFG_)

  rand uvm_reg_field STEP;
  rand uvm_reg_field INTR;
  rand uvm_reg_field EXIT;

  function new (string name = "WDDR_MCU_MCU_MCU_DEBUG_CFG_");
    super.new(name, 32, UVM_NO_COVERAGE);
  endfunction

  //Addr        : 0x803c     (Includes Map Offset)
  //Map         : MAP_APB     0x0
  //Reset       : 0x0       
  //Description : Debug control configuration register.
  function void build;
    //Description: 
    STEP = uvm_reg_field::type_id::create("STEP");  //     DEBUG_CFG__STEP
    STEP.configure(this, 1, 2, "RW", 0, 'h0, 1, 1, 0);
    //Description: 
    INTR = uvm_reg_field::type_id::create("INTR");  //     DEBUG_CFG__INTR
    INTR.configure(this, 1, 0, "RW", 0, 'h0, 1, 1, 0);
    //Description: 
    EXIT = uvm_reg_field::type_id::create("EXIT");  //     DEBUG_CFG__EXIT
    EXIT.configure(this, 1, 4, "RW", 0, 'h0, 1, 1, 0);
  endfunction
endclass

