  //Addr        : 0x90008    (Includes Map Offset)
  //Map         : MAP_APB     0x0
  //Reset       : 0x0       
  //Description : CMN REFGEN/VREF configuration register.
  function void build;
    //Description: 
    PWR = uvm_reg_field::type_id::create("PWR");  //    VREF_M0_CFG__PWR
    PWR.configure(this, 2, 11, "RW", 0, 'h0, 1, 1, 0);
    //Description: 
    HIZ = uvm_reg_field::type_id::create("HIZ");  //    VREF_M0_CFG__HIZ
    HIZ.configure(this, 1, 10, "RW", 0, 'h0, 1, 1, 0);
    //Description: 
    EN = uvm_reg_field::type_id::create("EN");  //     VREF_M0_CFG__EN
    EN.configure(this, 1, 9, "RW", 0, 'h0, 1, 1, 0);
    //Description: 
    CTRL = uvm_reg_field::type_id::create("CTRL");  //   VREF_M0_CFG__CTRL
    CTRL.configure(this, 8, 0, "RW", 0, 'h0, 1, 1, 0);
  endfunction
endclass

