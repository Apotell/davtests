// System: WDDR_ @ 0x0
//     System: WDDR_mcu @ 0x0
//       RegBlock: WDDR_MCU_MCUTOP_MCUTOP_(MCUTOP_)         @ 0x0
//       RegBlock: WDDR_MCU_MCUINTF_MCUINTF_(MCUINTF_)      @ 0x4000
//       RegBlock: WDDR_MCU_MCU_MCU_(MCU_)                  @ 0x8000
//   RegBlock: WDDR_CMN_CMN_(CMN_)                      @ 0x90008
//   RegBlock: WDDR_CMN_PLL_(CMN_PLL_MVP_PLL)           @ 0x98000
//   RegBlock: WDDR_FSW_FSW_(FSW_)                      @ 0xa0000
//   RegBlock: WDDR_CTRL_CTRL_(CTRL_)                   @ 0xb0000
//   RegBlock: WDDR_DFI_DFI_(DFI_)                      @ 0xc0000
//   RegBlock: WDDR_DFICH0_DFICH_(DFICH0_)              @ 0xd0000
//   RegBlock: WDDR_CH0_DQ0_DQ_(CH0_DQ0_)               @ 0xf0000
//   RegBlock: WDDR_CH0_DQ1_DQ_(CH0_DQ1_)               @ 0x100000
//   RegBlock: WDDR_CH0_CA_CA_(CH0_CA_)                 @ 0x110000
//   RegBlock: WDDR_CH1_DQ0_DQ_(CH1_DQ0_)               @ 0x120000
//   RegBlock: WDDR_CH1_DQ1_DQ_(CH1_DQ1_)               @ 0x130000
//   RegBlock: WDDR_CH1_CA_CA_(CH1_CA_)                 @ 0x140000



// RegBlock WDDR_MCU_MCUTOP_MCUTOP_
class WDDR_MCU_MCUTOP_MCUTOP_RSVD_ extends uvm_reg;
  `uvm_object_utils(WDDR_MCU_MCUTOP_MCUTOP_RSVD_)

  rand uvm_reg_field RSVD;

  function new (string name = "WDDR_MCU_MCUTOP_MCUTOP_RSVD_");
    super.new(name, 32, UVM_NO_COVERAGE);
  endfunction

  //Addr        : 0x0        (Includes Map Offset)
  //Map         : MAP_APB     0x0
  //Reset       : 0x0       
  //Description : RSVD.
  function void build;
    //Description: 
    RSVD = uvm_reg_field::type_id::create("RSVD");  //          RSVD__RSVD
    RSVD.configure(this, 32, 0, "RW", 0, 'h0, 1, 1, 0);
  endfunction
endclass

class WDDR_MCU_MCUTOP_MCUTOP_CFG_ extends uvm_reg;
