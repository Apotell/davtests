# Shared logic for the davtests C++ test executables.
#
# Included by the root CMakeLists.txt and by every per-folder CMakeLists.txt
# under hlc/. Walking down from the root, the first folder that has its own
# CMakeLists.txt is handed to add_subdirectory() and owns every test_*.cpp
# below it; the walk does not look further into that folder. That file picks
# the mode for its folder:
#
#   davtests_add_folder(BULK)       one executable, bulk_<path>, for every
#                                   test_*.cpp below the folder
#   davtests_add_folder(PER_FILE)   one executable per test_*.cpp
#
# In BULK mode, STANDALONE <file>... (paths relative to the folder) keeps
# the listed files as their own executables. A subfolder with its own
# CMakeLists.txt is handled by that file, in either mode. test_*.cpp files
# that are not below any per-folder CMakeLists.txt get one executable each.
#
# A per-folder CMakeLists.txt can also be configured on its own to build just
# that folder, e.g.
#   cmake -S hlc/Google/chapter-6 -B out/chapter-6
# This module then performs the one-time setup below itself.

include_guard(GLOBAL)

get_filename_component(DAVTESTS_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(DAVTESTS_HLC_DIR "${DAVTESTS_ROOT}/hlc")

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
if(NOT CMAKE_RUNTIME_OUTPUT_DIRECTORY)
  set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin)
endif()

# GTest must be defined before find_package(HLC): HLCTargets.cmake checks
# if(NOT TARGET "GTest::gtest") and fails if it is absent.
# hlc::hlc_test already carries GTest::gtest as a transitive
# INTERFACE_LINK_LIBRARY, so it also provides headers to test_*.cpp files.
if(WIN32)
  set(gtest_force_shared_crt ON CACHE BOOL "" FORCE)
endif()
add_subdirectory("${DAVTESTS_ROOT}/third_party/googletest"
  "${CMAKE_BINARY_DIR}/third_party/googletest" EXCLUDE_FROM_ALL)

enable_testing()

set(HLC_BUILD_DIR "${DAVTESTS_ROOT}/build" CACHE PATH "hlc install directory")
cmake_path(ABSOLUTE_PATH HLC_BUILD_DIR BASE_DIRECTORY "${DAVTESTS_ROOT}" NORMALIZE OUTPUT_VARIABLE HLC_BUILD_DIR)

find_package(Threads REQUIRED)
find_package(HLC REQUIRED HINTS "${HLC_BUILD_DIR}")

target_compile_definitions(gmock INTERFACE GTEST_LINKED_AS_SHARED_LIBRARY=1)
target_compile_definitions(gmock_main INTERFACE GTEST_LINKED_AS_SHARED_LIBRARY=1)
target_compile_definitions(gtest INTERFACE GTEST_LINKED_AS_SHARED_LIBRARY=1)
target_compile_definitions(gtest_main INTERFACE GTEST_LINKED_AS_SHARED_LIBRARY=1)

# TEST_LIST_FILE: path to a file generated by scripts/shard_tests.py listing
# the test_*.cpp sources to build for this shard. Each line is one absolute
# POSIX path. When empty (the default), every test_*.cpp is built -- the
# normal path for local builds.
set(TEST_LIST_FILE "" CACHE FILEPATH "Shard list from shard_tests.py (empty = build all)")
if(TEST_LIST_FILE)
  file(STRINGS "${TEST_LIST_FILE}" DAVTESTS_TEST_LIST)
  set_property(GLOBAL PROPERTY DAVTESTS_USE_TEST_LIST TRUE)
  set_property(GLOBAL PROPERTY DAVTESTS_TEST_LIST "${DAVTESTS_TEST_LIST}")
endif()

# Applies the settings shared by every test executable.
function(davtests_configure_test_target TARGET)
  target_compile_definitions(${TARGET} PRIVATE
    GTEST_LINKED_AS_SHARED_LIBRARY=1
    HLDB_IMPORTS=1
    HLC_IMPORTS=1
  )
  target_include_directories(${TARGET} PRIVATE
    ${DAVTESTS_ROOT}/third_party/googletest/googletest/include
    ${DAVTESTS_ROOT}/third_party/googletest/googlemock/include
  )
  target_compile_options(${TARGET} PRIVATE
    "SHELL:$<IF:$<CXX_COMPILER_ID:MSVC>,/FI hlc/config.h,-include hlc/config.h>"
  )
  target_link_libraries(${TARGET} PRIVATE hlc::hlc_test)
endfunction()

# Registers a CTest test that runs EXE in WORK_DIR with the extra arguments.
function(davtests_add_ctest TEST_NAME EXE WORK_DIR)
  add_test(NAME ${TEST_NAME}
    COMMAND ${EXE} ${ARGN}
    WORKING_DIRECTORY "${WORK_DIR}")
  # hlc::Test writes its output to ::testing::TempDir()/hlc_test_<milliseconds>,
  # which collides when tests run in parallel (ctest -j). Give every test its
  # own temp root; gtest reads TEST_TMPDIR before TEMP/TMPDIR.
  set_tests_properties(${TEST_NAME} PROPERTIES
    ENVIRONMENT "TEST_TMPDIR=${CMAKE_BINARY_DIR}/tmp/${TEST_NAME}")
endfunction()

# One executable for one test_*.cpp, named after the file.
function(_davtests_add_standalone TEST_SRC)
  get_filename_component(TEST_NAME "${TEST_SRC}" NAME_WLE)
  get_filename_component(TEST_DIR  "${TEST_SRC}" DIRECTORY)
  add_executable(${TEST_NAME} "${TEST_SRC}")
  davtests_configure_test_target(${TEST_NAME})
  davtests_add_ctest(${TEST_NAME} ${TEST_NAME} "${TEST_DIR}")
endfunction()

# One executable for several test_*.cpp files. Each file guards its own main()
# with #ifndef DAVTESTS_BULK_BUILD, so common/bulk_main.cpp provides the only
# one. Every file still gets its own CTest test, named like its standalone
# executable and running only that file's test suites, so results stay per
# file, ctest -j can spread the executable across cores, and a crash only
# affects one file.
function(_davtests_add_bulk BULK_NAME)
  set(BULK_SOURCES ${ARGN})
  list(LENGTH BULK_SOURCES BULK_COUNT)
  message(STATUS "davtests: ${BULK_NAME} <- ${BULK_COUNT} test files")

  add_executable(${BULK_NAME} ${BULK_SOURCES} "${DAVTESTS_ROOT}/common/bulk_main.cpp")
  davtests_configure_test_target(${BULK_NAME})
  target_compile_definitions(${BULK_NAME} PRIVATE DAVTESTS_BULK_BUILD=1)

  set(BULK_FIXTURES "")
  foreach(TEST_SRC IN LISTS BULK_SOURCES)
    # Fixtures all live in namespace hlc; two with the same name in one
    # executable would violate the ODR, so refuse to combine them.
    file(STRINGS "${TEST_SRC}" TEST_CLASSES REGEX "^class [A-Za-z0-9_]+ : public")
    foreach(TEST_CLASS IN LISTS TEST_CLASSES)
      string(REGEX REPLACE "^class ([A-Za-z0-9_]+) .*$" "\\1" TEST_CLASS "${TEST_CLASS}")
      if(TEST_CLASS IN_LIST BULK_FIXTURES)
        message(FATAL_ERROR "davtests: fixture '${TEST_CLASS}' is defined more than once in ${BULK_NAME} (seen again in ${TEST_SRC})")
      endif()
      list(APPEND BULK_FIXTURES "${TEST_CLASS}")
    endforeach()

    file(STRINGS "${TEST_SRC}" TEST_MACROS REGEX "^[ \t]*TEST(_F|_P)?[ \t]*\\([ \t]*[A-Za-z0-9_]+[ \t]*,")
    set(TEST_SUITES "")
    foreach(TEST_MACRO IN LISTS TEST_MACROS)
      string(REGEX REPLACE "^[ \t]*TEST(_F|_P)?[ \t]*\\([ \t]*([A-Za-z0-9_]+).*$" "\\2" TEST_SUITE "${TEST_MACRO}")
      list(APPEND TEST_SUITES "${TEST_SUITE}.*")
    endforeach()
    list(REMOVE_DUPLICATES TEST_SUITES)
    if(NOT TEST_SUITES)
      message(FATAL_ERROR "davtests: no TEST/TEST_F/TEST_P found in ${TEST_SRC}")
    endif()
    list(JOIN TEST_SUITES ":" TEST_FILTER)

    get_filename_component(TEST_NAME "${TEST_SRC}" NAME_WLE)
    get_filename_component(TEST_DIR  "${TEST_SRC}" DIRECTORY)
    davtests_add_ctest(${TEST_NAME} ${BULK_NAME} "${TEST_DIR}" "--gtest_filter=${TEST_FILTER}")
  endforeach()
endfunction()

# Finds the test_*.cpp files below DIR. Sets OUT_FILES to the ones DIR builds
# itself and OUT_OWNERS to the topmost subfolders that have their own
# CMakeLists.txt and own the rest. Honors TEST_LIST_FILE.
function(_davtests_scan DIR OUT_FILES OUT_OWNERS)
  file(GLOB_RECURSE SCAN_SOURCES CONFIGURE_DEPENDS "${DIR}/test_*.cpp")
  file(GLOB_RECURSE SCAN_LISTS CONFIGURE_DEPENDS "${DIR}/CMakeLists.txt")

  set(SCAN_ALL_OWNERS "")
  foreach(SCAN_LIST IN LISTS SCAN_LISTS)
    get_filename_component(SCAN_OWNER "${SCAN_LIST}" DIRECTORY)
    if(NOT SCAN_OWNER STREQUAL DIR)
      list(APPEND SCAN_ALL_OWNERS "${SCAN_OWNER}")
    endif()
  endforeach()

  # Only the topmost owners; deeper ones are reached through them.
  set(SCAN_TOP_OWNERS "")
  foreach(SCAN_OWNER IN LISTS SCAN_ALL_OWNERS)
    set(SCAN_NESTED FALSE)
    foreach(SCAN_OTHER IN LISTS SCAN_ALL_OWNERS)
      if(NOT SCAN_OTHER STREQUAL SCAN_OWNER)
        cmake_path(IS_PREFIX SCAN_OTHER "${SCAN_OWNER}" NORMALIZE SCAN_INSIDE)
        if(SCAN_INSIDE)
          set(SCAN_NESTED TRUE)
          break()
        endif()
      endif()
    endforeach()
    if(NOT SCAN_NESTED)
      list(APPEND SCAN_TOP_OWNERS "${SCAN_OWNER}")
    endif()
  endforeach()

  get_property(SCAN_USE_LIST GLOBAL PROPERTY DAVTESTS_USE_TEST_LIST)
  get_property(SCAN_TEST_LIST GLOBAL PROPERTY DAVTESTS_TEST_LIST)
  set(SCAN_FILES "")
  set(SCAN_USED_OWNERS "")
  foreach(SCAN_SRC IN LISTS SCAN_SOURCES)
    if(SCAN_USE_LIST AND NOT SCAN_SRC IN_LIST SCAN_TEST_LIST)
      continue()
    endif()
    set(SCAN_OWNED "")
    foreach(SCAN_OWNER IN LISTS SCAN_TOP_OWNERS)
      cmake_path(IS_PREFIX SCAN_OWNER "${SCAN_SRC}" NORMALIZE SCAN_INSIDE)
      if(SCAN_INSIDE)
        set(SCAN_OWNED "${SCAN_OWNER}")
        break()
      endif()
    endforeach()
    if(SCAN_OWNED)
      list(APPEND SCAN_USED_OWNERS "${SCAN_OWNED}")
    else()
      list(APPEND SCAN_FILES "${SCAN_SRC}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES SCAN_USED_OWNERS)

  set(${OUT_FILES} "${SCAN_FILES}" PARENT_SCOPE)
  set(${OUT_OWNERS} "${SCAN_USED_OWNERS}" PARENT_SCOPE)
endfunction()

# Builds the test_*.cpp files below DIR in MODE (BULK or PER_FILE); ARGN lists
# absolute paths to keep standalone in BULK mode.
function(_davtests_build DIR MODE)
  set(BUILD_STANDALONE ${ARGN})
  _davtests_scan("${DIR}" BUILD_FILES BUILD_OWNERS)
  foreach(BUILD_OWNER IN LISTS BUILD_OWNERS)
    add_subdirectory("${BUILD_OWNER}")
  endforeach()

  set(BUILD_BULK "")
  foreach(TEST_SRC IN LISTS BUILD_FILES)
    if(MODE STREQUAL "BULK" AND NOT TEST_SRC IN_LIST BUILD_STANDALONE)
      file(STRINGS "${TEST_SRC}" TEST_GUARD REGEX "DAVTESTS_BULK_BUILD" LIMIT_COUNT 1)
      if(TEST_GUARD)
        list(APPEND BUILD_BULK "${TEST_SRC}")
        continue()
      endif()
      message(STATUS "davtests: main() not guarded with DAVTESTS_BULK_BUILD, building standalone: ${TEST_SRC}")
    endif()
    _davtests_add_standalone("${TEST_SRC}")
  endforeach()

  if(BUILD_BULK)
    cmake_path(IS_PREFIX DAVTESTS_HLC_DIR "${DIR}" NORMALIZE BUILD_IN_HLC)
    if(BUILD_IN_HLC)
      cmake_path(RELATIVE_PATH DIR BASE_DIRECTORY "${DAVTESTS_HLC_DIR}" OUTPUT_VARIABLE BUILD_REL)
    else()
      get_filename_component(BUILD_REL "${DIR}" NAME)
    endif()
    string(REPLACE "/" "_" BUILD_NAME "bulk_${BUILD_REL}")
    _davtests_add_bulk(${BUILD_NAME} ${BUILD_BULK})
  endif()
endfunction()

# For the root CMakeLists.txt: builds every test_*.cpp below DIR as its own
# executable, except below folders that have their own CMakeLists.txt.
function(davtests_add_tree DIR)
  _davtests_build("${DIR}" PER_FILE)
endfunction()

# For a per-folder CMakeLists.txt; see the top of this file.
function(davtests_add_folder MODE)
  cmake_parse_arguments(PARSE_ARGV 1 FOLDER "" "" "STANDALONE")
  if(NOT MODE MATCHES "^(BULK|PER_FILE)$")
    message(FATAL_ERROR "davtests_add_folder: mode must be BULK or PER_FILE, got '${MODE}' in ${CMAKE_CURRENT_LIST_FILE}")
  endif()
  if(FOLDER_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "davtests_add_folder: unexpected arguments '${FOLDER_UNPARSED_ARGUMENTS}' in ${CMAKE_CURRENT_LIST_FILE}")
  endif()
  set(FOLDER_STANDALONE_ABS "")
  foreach(FOLDER_REL IN LISTS FOLDER_STANDALONE)
    cmake_path(SET FOLDER_ABS NORMALIZE "${CMAKE_CURRENT_SOURCE_DIR}/${FOLDER_REL}")
    if(NOT EXISTS "${FOLDER_ABS}")
      message(FATAL_ERROR "davtests_add_folder: STANDALONE file not found: ${FOLDER_REL} (in ${CMAKE_CURRENT_LIST_FILE})")
    endif()
    list(APPEND FOLDER_STANDALONE_ABS "${FOLDER_ABS}")
  endforeach()
  if(FOLDER_STANDALONE_ABS AND MODE STREQUAL "PER_FILE")
    message(WARNING "davtests_add_folder: STANDALONE has no effect in PER_FILE mode (${CMAKE_CURRENT_LIST_FILE})")
  endif()
  _davtests_build("${CMAKE_CURRENT_SOURCE_DIR}" ${MODE} ${FOLDER_STANDALONE_ABS})
endfunction()
